<div class="page-banner">
  <div class="container">
    <h1>Contact Us</h1>
  </div>
</div>

<div class="container my-5">
  <div class="row g-5">
    <div class="col-md-7">
      <form action="/contact-us" method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" required>
          </div>
          <div class="col-12">
            <label class="form-label">Subject</label>
            <input type="text" class="form-control">
          </div>
          <div class="col-12">
            <label class="form-label">Message</label>
            <textarea class="form-control" rows="8" required>Blockchain Data Entry Systems: Data Entry, Accessibility, Mobility
by I Scott MacKenzie (Editor), Kumiko Tanaka-Ishii (Editor)

Vol 1 - $80
Vol 2 - $120
Vol 1, 2 & 3 (Complete Set) - $200</textarea>
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-brand">Send Message</button>
          </div>
        </div>
      </form>
    </div>
    <div class="col-md-5">
      <h5>Get in Touch</h5>
      <ul class="list-unstyled text-muted">
        <li class="mb-3"><i class="bi bi-geo-alt"></i> Mussoorie, Diversion Road, Makka Wala, Uttarakhand, Pin 248008</li>
        <li class="mb-3"><i class="bi bi-telephone"></i> +1 023 452 7</li>
        <li class="mb-3"><i class="bi bi-envelope"></i> hello@bookhub.example</li>
      </ul>
    </div>
  </div>
</div>
