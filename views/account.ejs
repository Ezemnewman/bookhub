<div class="page-banner">
  <div class="container">
    <h1>My Account</h1>
  </div>
</div>

<div class="container my-5">
  <div class="row g-5">
    <div class="col-md-4">
      <div class="auth-card">
        <i class="bi bi-person-circle fs-1" style="color: var(--brand)"></i>
        <h5 class="mt-3 mb-0"><%= currentUser.name %></h5>
        <p class="text-muted"><%= currentUser.email %></p>
        <form action="/logout" method="POST">
          <button class="btn btn-outline-brand w-100">Log Out</button>
        </form>
      </div>
    </div>
    <div class="col-md-8">
      <h5 class="mb-3">Order History</h5>
      <% if (myOrders.length === 0) { %>
        <p class="text-muted">You haven't placed any orders yet.</p>
        <a href="/shop" class="btn btn-brand">Browse Books</a>
      <% } else { %>
        <% myOrders.forEach(order => { %>
          <div class="border rounded p-3 mb-3">
            <div class="d-flex justify-content-between mb-2">
              <strong>Order #<%= order.id %></strong>
              <span class="text-muted small"><%= order.date %></span>
            </div>
            <% order.items.forEach(item => { %>
              <div class="d-flex justify-content-between small text-muted">
                <span><%= item.title %> &times; <%= item.qty %></span>
                <span>
                  $<%= item.subtotal.toFixed(2) %>
                  <a href="#" class="ms-2" title="Download"><i class="bi bi-cloud-arrow-down"></i></a>
                </span>
              </div>
            <% }) %>
            <div class="d-flex justify-content-between fw-semibold mt-2 pt-2 border-top">
              <span>Total</span><span>$<%= order.total.toFixed(2) %></span>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>
