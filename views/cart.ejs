<div class="page-banner">
  <div class="container">
    <h1>Your Cart</h1>
  </div>
</div>

<div class="container my-5">
  <% if (items.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-bag-x fs-1 text-muted"></i>
      <p class="mt-3">Your cart is empty.</p>
      <a href="/shop" class="btn btn-brand">Browse Books</a>
    </div>
  <% } else { %>
    <div class="row g-5">
      <div class="col-lg-8">
        <table class="table align-middle cart-table">
          <thead>
            <tr><th>Book</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-3">
                    <img src="<%= item.cover %>" alt="<%= item.title %>">
                    <div>
                      <a href="/book/<%= item.id %>" class="fw-semibold text-dark"><%= item.title %></a>
                      <div class="text-muted small">by <%= item.author %></div>
                    </div>
                  </div>
                </td>
                <td>$<%= item.price.toFixed(2) %></td>
                <td>
                  <form action="/cart/update/<%= item.id %>" method="POST" class="d-flex align-items-center gap-2">
                    <input type="number" name="qty" value="<%= item.qty %>" min="1" class="form-control form-control-sm" style="width: 70px">
                    <button class="btn btn-sm btn-outline-secondary" type="submit">Update</button>
                  </form>
                </td>
                <td>$<%= item.subtotal.toFixed(2) %></td>
                <td>
                  <form action="/cart/remove/<%= item.id %>" method="POST">
                    <button class="btn btn-sm btn-link text-danger" title="Remove"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <a href="/shop" class="btn btn-outline-brand"><i class="bi bi-arrow-left"></i> Continue Shopping</a>
      </div>

      <div class="col-lg-4">
        <div class="summary-box">
          <h5 class="mb-3">Order Summary</h5>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Items (<%= items.reduce((a,i) => a + i.qty, 0) %>)</span>
            <span>$<%= total.toFixed(2) %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Download fee</span>
            <span>$0.00</span>
          </div>
          <div class="d-flex justify-content-between total-row">
            <span>Total</span>
            <span>$<%= total.toFixed(2) %></span>
          </div>
          <a href="/checkout" class="btn btn-brand w-100 mt-4">Proceed to Checkout</a>
        </div>
      </div>
    </div>
  <% } %>
</div>
