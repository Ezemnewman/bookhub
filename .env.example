# Postgres connection string.
# Railway: Add a Postgres plugin to your project — it provides this automatically
#   as ${{Postgres.DATABASE_URL}}; reference it or copy the value here.
# Vercel: Add Vercel Postgres (or an external provider like Neon/Supabase) and
#   copy the connection string it gives you.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Any long random string — used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set automatically by most platforms — safe to leave unset locally.
NODE_ENV=development

# Only needed if your local Postgres doesn't use SSL (managed providers do).
# DATABASE_SSL=false
